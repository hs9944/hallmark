const CHARMS = RAW.map(r => ({id:r[0], name:r[1], cat:r[2], file:r[0] + '.png'}));
const BY = {}; CHARMS.forEach(c => { BY[c.id] = c; });
/* checkout.js names the charms on the order from this when an older bag item has no names */
window.CHARMIE_CHARMS = {}; CHARMS.forEach(c => { window.CHARMIE_CHARMS[c.id] = c.name; });
const CATS = ['Cartoon','Pokémon','Superheroes','Anime','Harry Potter','Travel','Evil eye','Food & drink','Animals','Lifestyle'].filter(k => CHARMS.some(c => c.cat === k));

const PIECES = {
  bracelet:{name:'Bracelet', base:PRICING.custom.bracelet, path:'M70,105 C 200,285 520,285 650,105', bg:['#FBE8EF','#F7D6E2']},
  anklet:{name:'Anklet', base:PRICING.custom.anklet, path:'M50,120 C 200,265 520,265 670,120', bg:['#EAF7F1','#D8F1E7']},
  necklace:{name:'Necklace', base:PRICING.custom.necklace, path:'M60,40 C 130,370 590,370 660,40', bg:['#FFF7E3','#F3DFA8']},
  waist:{name:'Waist chain', base:PRICING.custom.waist, path:'M20,140 C 230,265 490,265 700,140', bg:['#FDF1E6','#EFCDAE'], drop:true}
};
const CHAINS = {
  g1:{name:'Textured curb', desc:'Narrow textured curb chain. Sparkly, our classic.', w:1.15, style:'textured', img:'assets/chains/g1.webp'},
  g2:{name:'Double-link', desc:'Narrow double-link chain. Flat, bold, a little luxe.', w:1.35, style:'double', img:'assets/chains/g2.webp'},
  g3:{name:'Fine curb', desc:'Fine curb chain. Delicate and barely-there.', w:0.8, style:'fine', img:'assets/chains/g3.webp'}
};
const GOLD = {stroke:'#C9A85A', stroke2:'#F1DB9A', dark:'#A8842E'};
const INCLUDED = PRICING.includedCharms, EXTRA = PRICING.extraCharm, MAX = PRICING.maxCharms, HIST = 20;
const KIND = {bracelet:'Bracelet', anklet:'Anklet', necklace:'Necklace', keychain:'Keychain'};

/* ---------- helpers ---------- */
const $ = s => document.querySelector(s);
const inr = v => '₹' + v.toLocaleString('en-IN');
const plural = (k, w) => k + ' ' + w + (k === 1 ? '' : 's');
const esc = s => String(s).replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
function el(n, a){ const e = document.createElementNS(NS, n); for (const k in a) e.setAttribute(k, a[k]); return e; }
const store = {
  get(k, d){ try{ const v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; }catch(e){ return d; } },
  set(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
};

const stageSvg = $('#stage'), frame = $('#frame'), slotsUl = $('#slots'), live = $('#live'), toastEl = $('#toast');
const grid = $('#grid'), chosenEl = $('#chosen'), railEl = $('#rail'), railList = $('#railList'), searchEl = $('#q'), catsEl = $('#cats');
const bagBtn = $('#bagBtn'), bagPanel = $('#bagPanel'), scrimEl = $('#scrim');
const phoneMQ = window.matchMedia('(max-width:1023.98px)');
const reduceMQ = window.matchMedia('(prefers-reduced-motion: reduce)');

/* ---------- state ---------- */
function sanitize(d){
  d = d || {};
  return {
    piece: Object.hasOwn(PIECES, d.piece) ? d.piece : 'bracelet',
    chain: Object.hasOwn(CHAINS, d.chain) ? d.chain : 'g1',
    charms: (Array.isArray(d.charms) ? d.charms : []).filter(id => typeof id === 'string' && Object.hasOwn(BY, id)).slice(0, MAX)
  };
}
function parseHash(){
  const h = location.hash.replace(/^#/, '');
  if (!h) return null;
  try{
    const p = new URLSearchParams(h);
    if (!p.has('p') && !p.has('i')) return null;
    /* a piece-only link (e.g. #p=waist) keeps the saved chain and charms */
    const keep = p.has('i') ? {} : sanitize(store.get('charmie-design', null));
    return sanitize({piece:p.get('p'), chain:p.get('c') || keep.chain, charms:p.has('i') ? (p.get('i') || '').split(',').filter(Boolean) : keep.charms});
  }catch(e){ return null; }
}
const fromHash = parseHash();
const storedDesign = store.get('charmie-design', null);
let S = fromHash || sanitize(storedDesign);
let sel = null, tabSlot = 0, fresh = -1, q = '', cat = 'All';
let past = [], future = [];
const openSteps = new Set((fromHash || (storedDesign && sanitize(storedDesign).charms.length)) ? [3] : [1]);
/* shared bag (also used by index.html): custom items have no type or type 'custom';
   ready-made items are {type:'design', id, name, kind, price, img} */
function validItem(i){
  if (!i || typeof i !== 'object' || typeof i.price !== 'number') return false;
  if (i.type === 'design') return typeof i.id === 'string' && typeof i.name === 'string' && Object.hasOwn(KIND, i.kind);
  return (i.type === undefined || i.type === 'custom') && Object.hasOwn(PIECES, i.piece) && Object.hasOwn(CHAINS, i.chain) && Array.isArray(i.charms);
}
/* ---------- quantities (same block in index.html) ----------
   keychains are not one of one: one bag line per keychain (same id + kind) carrying qty 1–10.
   one-of-one designs and custom pieces never carry qty and always count as 1. price stays the unit price. */
const QTY_MAX = 10;
const isKey = i => i.type === 'design' && i.id.indexOf('keychain-') === 0;
const qtyOf = i => isKey(i) ? (i.qty || 1) : 1;
const lineKey = i => i.id + '|' + i.kind;
const bagCount = list => list.reduce((s, i) => s + qtyOf(i), 0);
const bagSum = list => list.reduce((s, i) => s + i.price * qtyOf(i), 0);
/* clamps qty and merges duplicate keychain lines (older bags pushed one line per add) */
function mergeCart(list){
  const out = [], seen = Object.create(null);
  let changed = false;
  list.forEach(i => {
    if (!isKey(i)){ if ('qty' in i){ delete i.qty; changed = true; } out.push(i); return; }
    const q = Math.min(QTY_MAX, Math.max(1, Math.floor(Number(i.qty)) || 1));
    const prev = seen[lineKey(i)];
    if (prev){ prev.qty = Math.min(QTY_MAX, prev.qty + q); changed = true; return; }
    if (i.qty !== q){ i.qty = q; changed = true; }
    seen[lineKey(i)] = i; out.push(i);
  });
  return {list: out, changed};
}
/* bag-panel controls for a keychain line: − qty +, line price (unit × qty), Remove */
function qtyCtl(it, idx, t){
  const q = qtyOf(it), n = esc(t);
  return '<div class="bctl"><span class="qs" role="group" aria-label="Quantity of ' + n + '">'
    + '<button type="button" class="qb" data-q="-1" data-line="' + idx + '" aria-label="Decrease quantity of ' + n + '"' + (q <= 1 ? ' aria-disabled="true"' : '') + '>−</button>'
    + '<span class="qn">' + q + '</span>'
    + '<button type="button" class="qb" data-q="1" data-line="' + idx + '" aria-label="Increase quantity of ' + n + '"' + (q >= QTY_MAX ? ' aria-disabled="true"' : '') + '>+</button></span>'
    + '<span class="lp">' + inr(it.price * q) + (q > 1 ? '<small>' + inr(it.price) + ' each</small>' : '') + '</span>'
    + '<button type="button" class="link-btn" data-idx="' + idx + '" aria-label="Remove ' + n + ' (item ' + (idx + 1) + ') from bag">Remove</button></div>';
}
/* step a keychain line by d (+1/−1) against the freshly loaded bag; caller saves when changed */
function stepQty(idx, d){
  const cur = cart[idx];
  if (!cur || !isKey(cur)) return {msg:'', changed:false, at:-1};
  const key = lineKey(cur);
  cart = loadCart();
  const at = cart.findIndex(i => isKey(i) && lineKey(i) === key), it = cart[at];
  if (!it) return {msg: cur.name + ' is no longer in your bag.', changed:false, at:-1};
  if (d > 0 && it.qty >= QTY_MAX) return {msg:'You can add up to ' + QTY_MAX + ' of each keychain.', changed:false, at};
  if (d < 0 && it.qty <= 1) return {msg:'Use Remove to take ' + it.name + ' out of your bag.', changed:false, at};
  it.qty += d;
  return {msg: it.name + ' quantity ' + it.qty, changed:true, at};
}
function loadCart(){
  const c = store.get('charmie-cart', []);
  if (!Array.isArray(c)) return [];
  const m = mergeCart(c.filter(validItem));
  if (m.changed) store.set('charmie-cart', m.list);
  return m.list;
}
let cart = loadCart();

const count = () => S.charms.length;
const slotCount = () => Math.max(INCLUDED, Math.min(MAX, count() + 1));
const price = () => PIECES[S.piece].base + Math.max(0, count() - INCLUDED) * EXTRA;
const snap = () => ({piece:S.piece, chain:S.chain, charms:S.charms.slice()});
const persist = () => { store.set('charmie-design', snap()); const sp = $('#sharePanel'); if (sp) sp.hidden = true; };
function clearHash(){ try{ if (location.hash) history.replaceState(null, '', location.pathname + location.search); }catch(e){} }
if (fromHash){ persist(); clearHash(); }
const summary = () => count() + ' charms, ' + inr(price()) + '.';

function commit(fn){
  const before = snap();
  fn();
  if (before.piece === S.piece && before.chain === S.chain && before.charms.join() === S.charms.join()) return;
  past.push(before); if (past.length > HIST) past.shift();
  future = [];
  persist();
}

/* ---------- announcements ---------- */
let liveT, toastT;
function say(msg, visible){
  live.textContent = '';
  clearTimeout(liveT);
  liveT = setTimeout(() => { live.textContent = msg; }, 30);
  if (visible) toast(msg);
}
function toast(msg){
  toastEl.textContent = msg; toastEl.classList.add('on');
  startToastTimer();
}
function startToastTimer(){ clearTimeout(toastT); toastT = setTimeout(() => toastEl.classList.remove('on'), 6000); }
toastEl.addEventListener('mouseenter', () => clearTimeout(toastT));
toastEl.addEventListener('mouseleave', () => { if (toastEl.classList.contains('on')) startToastTimer(); });

/* ---------- stage rendering ---------- */
function renderStage(){
  const P = PIECES[S.piece], Ch = CHAINS[S.chain], cnt = slotCount(), n = count();
  const prev = document.activeElement;
  const keep = (prev && prev.classList && prev.classList.contains('slot')) ? +prev.dataset.i : null;
  frame.dataset.piece = S.piece;
  while (stageSvg.firstChild) stageSvg.removeChild(stageSvg.firstChild);
  const d = P.path, w = 4.6 * Ch.w;
  const base = el('path', {d:d, fill:'none', stroke:GOLD.stroke, 'stroke-width':w, 'stroke-linecap':'round'});
  stageSvg.appendChild(base);
  if (Ch.style === 'double'){
    stageSvg.appendChild(el('path', {d:d, fill:'none', stroke:GOLD.dark, 'stroke-width':w*.32, 'stroke-linecap':'round'}));
    stageSvg.appendChild(el('path', {d:d, fill:'none', stroke:GOLD.stroke2, 'stroke-width':w*.5, 'stroke-dasharray':(w*.9) + ' ' + (w*.9), 'stroke-linecap':'butt'}));
  } else if (Ch.style === 'textured'){
    stageSvg.appendChild(el('path', {d:d, fill:'none', stroke:GOLD.stroke2, 'stroke-width':w*.5, 'stroke-dasharray':(w*.6) + ' ' + (w*.9), 'stroke-linecap':'round'}));
    stageSvg.appendChild(el('path', {d:d, fill:'none', stroke:'#fff', 'stroke-width':w*.18, 'stroke-dasharray':'1 ' + (w*1.5), 'stroke-opacity':.8}));
  } else {
    stageSvg.appendChild(el('path', {d:d, fill:'none', stroke:GOLD.stroke2, 'stroke-width':w*.45, 'stroke-dasharray':'2.5 2.5', 'stroke-linecap':'round'}));
  }
  stageSvg.appendChild(el('path', {d:d, 'class':'shim ui', fill:'none', stroke:'#fff', 'stroke-opacity':.75, 'stroke-width':w*.6, 'stroke-linecap':'round'}));

  const L = base.getTotalLength();
  const size = cnt <= 6 ? 94 : cnt <= 8 ? 80 : cnt <= 10 ? 68 : 58;
  const pos = [];
  for (let i = 0; i < cnt; i++){
    const t = (i + 1) / (cnt + 1), p = base.getPointAtLength(t * L), p2 = base.getPointAtLength(Math.min(L, t * L + 1));
    const ang = Math.max(-25, Math.min(25, Math.atan2(p2.y - p.y, p2.x - p.x) * 180 / Math.PI * .2));
    const py = p.y + (cnt > 8 ? (i % 2 ? 8 : -8) : 0);
    pos.push({x:p.x, y:py});
    const g = el('g', {transform:'translate(' + p.x.toFixed(1) + ',' + py.toFixed(1) + ')'});
    g.appendChild(el('circle', {cx:0, cy:size*.11, r:size*.07, fill:'none', stroke:GOLD.stroke, 'stroke-width':2}));
    const c = BY[S.charms[i]];
    if (c){
      const drop = el('g', i === fresh ? {'class':'dropin'} : {});
      const sway = el('g', {'class':'sway', style:'animation-delay:-' + ((i * 0.7) % 4.8).toFixed(1) + 's'});
      sway.appendChild(el('image', {href:CIMG[c.file], x:-size/2, y:size*.18, width:size, height:size, preserveAspectRatio:'xMidYMin meet', transform:'rotate(' + ang.toFixed(2) + ',0,' + (size*.18) + ')'}));
      drop.appendChild(sway); g.appendChild(drop);
    } else {
      const ui = el('g', {'class':'ui'});
      ui.appendChild(el('circle', {cx:0, cy:size*.68, r:size*.37, fill:'rgba(255,255,255,.4)', stroke:'#8A6A1E', 'stroke-width':1.8, 'stroke-dasharray':'3 4'}));
      const tx = el('text', {x:0, y:size*.78, 'text-anchor':'middle', 'font-size':size*.3, fill:'#8A6A1E', 'font-family':'Fraunces, serif'});
      tx.textContent = '+'; ui.appendChild(tx);
      if (i === 0 && n === 0) ui.appendChild(el('circle', {'class':'pulse', cx:0, cy:size*.68, r:size*.42, fill:'none', stroke:GOLD.stroke, 'stroke-width':3, 'stroke-opacity':.95}));
      g.appendChild(ui);
    }
    if (sel === i) g.appendChild(el('circle', {'class':'ui', cx:0, cy:size*.68, r:size*.5, fill:'none', stroke:'#171717', 'stroke-width':2.5}));
    stageSvg.appendChild(g);
  }
  fresh = -1;

  const names = S.charms.map(id => BY[id].name);
  stageSvg.setAttribute('aria-label', P.name + ' on a ' + Ch.name + ' chain with ' + (n ? plural(n, 'charm') + ': ' + names.join(', ') : 'no charms yet') + '.');
  $('#stageHint').textContent = n ? (P.name + ' · ' + Ch.name) : 'Tap a slot to begin';

  const ts = Math.min(tabSlot, cnt - 1);
  if (slotsUl.children.length !== cnt){
    let html = '';
    for (let i = 0; i < cnt; i++) html += '<li><button type="button" class="slot" data-i="' + i + '"></button></li>';
    slotsUl.innerHTML = html;
  }
  let minD = 1e9;
  for (let i = 1; i < pos.length; i++) minD = Math.min(minD, Math.hypot(pos[i].x - pos[i - 1].x, pos[i].y - pos[i - 1].y));
  slotsUl.classList.toggle('dense', cnt > 8);
  slotsUl.style.setProperty('--sp', (minD * 0.95 / 720 * 100).toFixed(2));
  for (let i = 0; i < cnt; i++){
    const c = BY[S.charms[i]], pp = pos[i], li = slotsUl.children[i], btn = li.firstChild;
    const label = c ? 'Slot ' + (i + 1) + ', ' + c.name + ' — press Delete to remove' : 'Slot ' + (i + 1) + ', empty';
    li.style.cssText = '--x:' + (pp.x / 720 * 100).toFixed(2) + ';--y:' + ((pp.y + size * .62) / 420 * 100).toFixed(2) + ';--w:' + (size * 1.1 / 720 * 100).toFixed(2) + ';--h:' + (size * 1.2 / 420 * 100).toFixed(2);
    if (btn.getAttribute('aria-label') !== label) btn.setAttribute('aria-label', label);
    btn.setAttribute('aria-pressed', String(sel === i));
    btn.tabIndex = (i === ts) ? 0 : -1;
  }
  if (keep !== null){
    const b = slotsUl.querySelector('.slot[data-i="' + Math.min(keep, cnt - 1) + '"]');
    if (b) b.focus({preventScroll:true});
  }

  let hint;
  if (sel !== null) hint = 'Slot ' + (sel + 1) + ' selected. Pick a charm to ' + (S.charms[sel] ? 'swap it.' : 'place it.');
  else hint = n ? 'Select a slot to swap a charm, or tap a charm to add it.' : 'Tap a charm to add it, or select a slot first.';
  $('#hint').textContent = hint;
}

function focusSlot(i){
  const cnt = slotCount(); i = Math.max(0, Math.min(cnt - 1, i)); tabSlot = i;
  slotsUl.querySelectorAll('.slot').forEach(b => b.tabIndex = (+b.dataset.i === i) ? 0 : -1);
  const b = slotsUl.querySelector('.slot[data-i="' + i + '"]');
  if (b) b.focus({preventScroll:true});
}

/* ---------- steps ---------- */
function buildSteps(){
  $('#pieces').innerHTML = Object.keys(PIECES).map(k => {
    const P = PIECES[k];
    return '<button type="button" class="pcard' + (P.drop ? ' is-drop' : '') + '" data-k="' + k + '" aria-pressed="false">'
      + (P.drop ? '<span class="drop-badge">Limited drop</span> ' : '')
      + '<svg viewBox="0 0 720 420" aria-hidden="true" focusable="false"><path d="' + P.path + '" fill="none" stroke="' + GOLD.stroke + '" stroke-width="16" stroke-linecap="round"/><path d="' + P.path + '" fill="none" stroke="' + GOLD.stroke2 + '" stroke-width="7" stroke-dasharray="10 14" stroke-linecap="round"/></svg>'
      + '<strong>' + P.name + '</strong> <span>from ' + inr(P.base) + '</span><em class="tick" aria-hidden="true">✓</em></button>';
  }).join('');
  $('#chains').innerHTML = Object.keys(CHAINS).map(k => {
    const C = CHAINS[k];
    return '<button type="button" class="chcard" data-k="' + k + '" aria-pressed="false">'
      + '<span class="sw"><img src="' + C.img + '" width="56" height="56" alt="" decoding="async"></span>'
      + '<span><strong>' + C.name + '</strong><small>' + C.desc + '</small></span><em class="tick" aria-hidden="true">✓</em></button>';
  }).join('');
  catsEl.innerHTML = '';
  ['All'].concat(CATS).forEach(k => {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'pill'; b.textContent = k; b.dataset.k = k; b.setAttribute('aria-pressed', String(k === cat));
    catsEl.appendChild(b);
  });
}
function renderSteps(){
  const P = PIECES[S.piece], Ch = CHAINS[S.chain], n = count();
  for (let k = 1; k <= 3; k++){
    const open = openSteps.has(k);
    $('#h' + k).setAttribute('aria-expanded', String(open));
    $('#b' + k).hidden = !open;
    const li = document.querySelector('#prog li[data-p="' + k + '"]');
    if (li) li.classList.toggle('on', open);
  }
  document.body.classList.toggle('s3', openSteps.has(3));
  $('#sum1').textContent = P.name + ' · from ' + inr(P.base);
  $('#sum2').textContent = Ch.name;
  $('#sum3').textContent = n ? plural(n, 'charm') : 'None yet';
  document.querySelectorAll('.pcard').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.k === S.piece)));
  document.querySelectorAll('.chcard').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.k === S.chain)));
  queueCompact();
}
function setOpen(k, on){ if (on) openSteps.add(k); else openSteps.delete(k); renderSteps(); }
/* phones: bring a just-opened step out from under the pinned stage */
function revealStep(k){
  if (!phoneMQ.matches) return;
  const st = $('#step' + k); if (!st) return;
  requestAnimationFrame(() => st.scrollIntoView({block:'start', behavior:reduceMQ.matches ? 'auto' : 'smooth'}));
}
function advance(from, to){
  openSteps.delete(from); openSteps.add(to); renderSteps();
  const h = $('#h' + to); if (h) h.focus({preventScroll:true});
  revealStep(to);
}
document.querySelectorAll('.step-head').forEach(b => b.addEventListener('click', () => {
  const k = +b.id.slice(1), opening = !openSteps.has(k);
  setOpen(k, opening);
  if (opening) revealStep(k);
}));
$('#pieces').addEventListener('click', e => {
  const b = e.target.closest('.pcard'); if (!b) return;
  const k = b.dataset.k;
  if (k !== S.piece){
    commit(() => { S.piece = k; });
    sel = null; renderAll();
    say(PIECES[k].name + ' selected. From ' + inr(PIECES[k].base) + '. ' + summary());
  }
});
$('#next1').addEventListener('click', () => advance(1, 2));
$('#next2').addEventListener('click', () => advance(2, 3));
$('#chains').addEventListener('click', e => {
  const b = e.target.closest('.chcard'); if (!b) return;
  const k = b.dataset.k;
  if (k !== S.chain){
    commit(() => { S.chain = k; });
    renderAll();
    say(CHAINS[k].name + ' chain selected.');
  }
});

/* ---------- chosen chips, meter, rail ---------- */
function renderChosen(){
  const n = count(), used = Math.min(n, INCLUDED);
  $('#meterTxt').textContent = used + ' of ' + INCLUDED + ' included charms used' + (n > INCLUDED ? ' · ' + (n - INCLUDED) + ' extra' : '');
  $('#barFill').style.width = (used / INCLUDED * 100) + '%';
  if (!n){ chosenEl.innerHTML = '<li class="none">Nothing yet. Tap a charm below to add it.</li>'; return; }
  chosenEl.innerHTML = S.charms.map((id, i) => {
    const c = BY[id];
    return '<li class="cchip">'
      + '<button type="button" class="cc-main" data-i="' + i + '" aria-label="' + (i + 1) + '. ' + c.name + ', remove"><img src="' + CIMG[c.file] + '" width="32" height="32" alt="" decoding="async"><span>' + (i + 1) + '. ' + c.name + '</span><b aria-hidden="true">×</b></button>'
      + '<button type="button" class="cc-mv" data-i="' + i + '" data-d="-1" aria-label="Move ' + c.name + ' left"' + (i === 0 ? ' aria-disabled="true"' : '') + '>‹</button>'
      + '<button type="button" class="cc-mv" data-i="' + i + '" data-d="1" aria-label="Move ' + c.name + ' right"' + (i === n - 1 ? ' aria-disabled="true"' : '') + '>›</button>'
      + '</li>';
  }).join('');
}
function suggestions(){
  const n = count();
  if (n < 3 || n >= MAX) return [];
  const used = new Set(S.charms), cats = [];
  S.charms.forEach(id => { if (cats.indexOf(BY[id].cat) < 0) cats.push(BY[id].cat); });
  const lists = cats.map(k => CHARMS.filter(c => c.cat === k && !used.has(c.id)));
  const out = []; let r = 0;
  while (out.length < 4 && lists.some(l => l.length > r)){
    lists.forEach(l => { if (out.length < 4 && l[r]) out.push(l[r]); });
    r++;
  }
  return out;
}
function tileHTML(c, rail){
  return '<li><button type="button" class="ct" data-id="' + c.id + '" aria-label="' + c.name + '"><img src="' + CIMG[c.file] + '" width="80" height="80" alt="" loading="lazy" decoding="async"><span class="nm">' + c.name + '</span><span class="bdg" aria-hidden="true"></span></button></li>';
}
function renderRail(){
  const list = suggestions();
  railEl.hidden = !list.length;
  railList.innerHTML = list.map(c => tileHTML(c, true)).join('');
}
function updateTiles(){
  const counts = {};
  S.charms.forEach(id => { counts[id] = (counts[id] || 0) + 1; });
  document.querySelectorAll('.ct').forEach(b => {
    const c = counts[b.dataset.id] || 0;
    b.classList.toggle('used', c > 0);
    const nm = BY[b.dataset.id].name, lab = nm + (c ? ', in design ×' + c : '');
    if (b.getAttribute('aria-label') !== lab) b.setAttribute('aria-label', lab);
    b.querySelector('.bdg').textContent = c > 1 ? '×' + c : (c ? '✓' : '');
  });
}

/* ---------- picker ---------- */
function filtered(){
  /* accents folded so "pokemon" finds Pokémon */
  const fold = t => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const s = fold(q.trim());
  return CHARMS.filter(c => (cat === 'All' || c.cat === cat) && (!s || fold(c.name).indexOf(s) >= 0 || fold(c.cat).indexOf(s) >= 0));
}
function renderGrid(){
  const list = filtered();
  grid.innerHTML = list.map(c => tileHTML(c, false)).join('');
  $('#empty').hidden = list.length > 0;
  if (!list.length) $('#emptyQ').textContent = (q.trim() ? '“' + q.trim() + '”' : '') + (q.trim() && cat !== 'All' ? ' in ' : '') + (cat !== 'All' ? 'the ' + cat + ' category' : '');
  updateTiles();
  return list.length;
}
function syncCats(){ catsEl.querySelectorAll('.pill').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.k === cat))); }
let filterT;
function announceFilter(nn){ clearTimeout(filterT); filterT = setTimeout(() => say(nn ? plural(nn, 'charm') + ' shown.' : 'No charms match.'), 450); }
searchEl.addEventListener('input', () => { q = searchEl.value; announceFilter(renderGrid()); });
catsEl.addEventListener('click', e => {
  const b = e.target.closest('.pill'); if (!b) return;
  cat = b.dataset.k; syncCats(); announceFilter(renderGrid());
});
$('#clearFilters').addEventListener('click', () => {
  q = ''; cat = 'All'; searchEl.value = ''; syncCats(); renderGrid(); say('Filters cleared.'); searchEl.focus();
});
grid.addEventListener('click', e => { const b = e.target.closest('.ct'); if (b) addCharm(b.dataset.id); });
railList.addEventListener('click', e => {
  const b = e.target.closest('.ct'); if (!b) return;
  addCharm(b.dataset.id);
  const f = railList.querySelector('.ct'); if (f) f.focus({preventScroll:true});
});

/* ---------- mutations ---------- */
function addCharm(id){
  const c = BY[id]; if (!c) return;
  let i, replaced = false;
  if (sel !== null && sel < count()){ i = sel; replaced = true; commit(() => { S.charms[i] = id; }); }
  else {
    if (count() >= MAX){ say('A piece holds up to ' + MAX + ' charms.', true); return; }
    i = count(); commit(() => { S.charms.push(id); });
  }
  sel = null; fresh = i; tabSlot = i;
  renderAll();
  say(c.name + (replaced ? ' placed in slot ' : ' added to slot ') + (i + 1) + '. ' + summary());
}
function removeAt(i, where){
  const c = BY[S.charms[i]]; if (!c) return;
  commit(() => { S.charms.splice(i, 1); });
  sel = null; tabSlot = i;
  renderAll();
  say(c.name + ' removed from slot ' + (i + 1) + '. ' + summary());
  if (where === 'slot') focusSlot(i);
  else {
    const n = count();
    const t = n ? chosenEl.querySelector('.cc-main[data-i="' + Math.min(i, n - 1) + '"]') : searchEl;
    if (t) t.focus({preventScroll:true});
  }
}
function move(i, dir, where){
  const j = i + dir;
  if (i >= count()){ say('Slot is empty.'); return; }
  if (i < 0 || j < 0 || j >= count()){ say(j < 0 ? 'Already first.' : 'Already last.'); return; }
  const c = BY[S.charms[i]];
  commit(() => { const t = S.charms[i]; S.charms[i] = S.charms[j]; S.charms[j] = t; });
  sel = null; tabSlot = j;
  renderAll();
  say(c.name + ' moved to slot ' + (j + 1) + '.');
  if (where === 'slot') focusSlot(j);
  else {
    const t = chosenEl.querySelector('.cc-mv[data-i="' + j + '"][data-d="' + dir + '"]');
    if (t) t.focus({preventScroll:true});
  }
}
chosenEl.addEventListener('click', e => {
  const m = e.target.closest('.cc-main');
  if (m){ removeAt(+m.dataset.i, 'chip'); return; }
  const v = e.target.closest('.cc-mv');
  if (v && v.getAttribute('aria-disabled') !== 'true') move(+v.dataset.i, +v.dataset.d, 'chip');
  else if (v) say(+v.dataset.d < 0 ? 'Already first.' : 'Already last.');
});

/* ---------- slots ---------- */
slotsUl.addEventListener('click', e => {
  const b = e.target.closest('.slot'); if (!b) return;
  const i0 = +b.dataset.i;
  const i = (!S.charms[i0] && i0 > count()) ? count() : i0;
  sel = (sel === i) ? null : i; tabSlot = i;
  if (sel !== null) openSteps.add(3);
  renderAll();
  if (i !== i0) focusSlot(i);
  say(sel === null ? 'Slot ' + (i + 1) + ' deselected.' : (i !== i0 ? 'Charms fill slots in order, placing in slot ' + (i + 1) + '. ' : '') + 'Slot ' + (i + 1) + ' selected. Pick a charm to ' + (S.charms[i] ? 'swap it.' : 'place it.'));
});
slotsUl.addEventListener('keydown', e => {
  const b = e.target.closest('.slot'); if (!b) return;
  const i = +b.dataset.i, cnt = slotCount();
  if (e.shiftKey && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')){
    e.preventDefault(); move(i, e.key === 'ArrowLeft' ? -1 : 1, 'slot'); return;
  }
  switch (e.key){
    case 'ArrowRight': case 'ArrowDown': e.preventDefault(); focusSlot((i + 1) % cnt); break;
    case 'ArrowLeft': case 'ArrowUp': e.preventDefault(); focusSlot((i - 1 + cnt) % cnt); break;
    case 'Home': e.preventDefault(); focusSlot(0); break;
    case 'End': e.preventDefault(); focusSlot(cnt - 1); break;
    case 'Delete': case 'Backspace':
      e.preventDefault();
      if (S.charms[i]) removeAt(i, 'slot'); else say('Slot ' + (i + 1) + ' is empty.');
      break;
  }
});

/* ---------- price + bag ---------- */
let lastTotal = '';
function renderPrice(){
  const P = PIECES[S.piece], n = count(), extra = Math.max(0, n - INCLUDED), total = inr(price());
  let h = '<div class="lrow"><dt>' + P.name + ' base price</dt><dd>' + inr(P.base) + '</dd></div>'
    + '<div class="lrow"><dt>' + INCLUDED + ' charms included</dt><dd>Included</dd></div>';
  if (extra) h += '<div class="lrow"><dt>+' + extra + ' extra × ' + inr(EXTRA) + '</dt><dd>' + inr(extra * EXTRA) + '</dd></div>';
  h += '<div class="lrow total"><dt>Total</dt><dd id="total">' + total + '</dd></div>';
  $('#ledger').innerHTML = h;
  $('#barTotal').textContent = total;
  if (total !== lastTotal && lastTotal !== ''){
    const t = $('#total'); t.classList.add('tick-anim');
    const bt = $('#barTotal'); bt.classList.remove('tick-anim'); void bt.offsetWidth; bt.classList.add('tick-anim');
  }
  lastTotal = total;
  ['#addBag', '#addBag2'].forEach(s => $(s).setAttribute('aria-disabled', String(!n)));
}
function renderTools(){
  $('#undo').setAttribute('aria-disabled', String(!past.length));
  $('#redo').setAttribute('aria-disabled', String(!future.length));
}
function renderBag(){
  const n = bagCount(cart), total = bagSum(cart);
  $('#bagCnt').textContent = n; $('#bagCnt2').textContent = n;
  bagBtn.setAttribute('aria-label', 'Bag, ' + plural(n, 'item'));
  $('#bagBtn2').setAttribute('aria-label', 'Bag, ' + plural(n, 'item'));
  $('#bagTotal').textContent = inr(total);
  $('#bagList').innerHTML = cart.length ? cart.map((it, idx) => {
    const t = itemTitle(it);
    let thumb, sub;
    if (it.type === 'design'){
      /* bag items carry the old image path; map it to the photo files */
      const pm = typeof it.img === 'string' && it.img.match(/products\/(\d+)\.webp|keychains\/([\w-]+)\.jpg/);
      const src = pm ? (pm[1] ? 'assets/designs/d' + pm[1].padStart(2, '0') + '-400.webp' : 'assets/keychains/' + pm[2] + '-300.webp') : '';
      thumb = src ? '<img src="' + src + '" width="44" height="44" alt="" decoding="async">' : '<span class="bth" aria-hidden="true">✦</span>';
      /* keychain lines: name + kind, then the qty stepper row */
      if (isKey(it)) return '<li class="kq"><span class="bi">' + thumb + '<span>' + esc(t) + '<small>' + KIND[it.kind] + '</small></span></span>' + qtyCtl(it, idx, t) + '</li>';
      /* chosen piece first; only ready-made designs (id 'design-N') are one of one */
      sub = KIND[it.kind] + (it.id.indexOf('design-') === 0 ? ' · One of one' : '') + ' · ' + inr(it.price);
    } else {
      thumb = '<span class="bth" aria-hidden="true">✦</span>';
      sub = CHAINS[it.chain].name + ' · ' + plural(it.charms.length, 'charm') + ' · ' + inr(it.price);
    }
    return '<li><span class="bi">' + thumb + '<span>' + esc(t) + '<small>' + sub + '</small></span></span>'
      + '<button type="button" class="link-btn" data-idx="' + idx + '" aria-label="Remove ' + esc(t) + ' (item ' + (idx + 1) + ') from bag">Remove</button></li>';
  }).join('') : '<li>Your bag is empty.</li>';
}
function itemTitle(it){
  return it.type === 'design' ? it.name : 'Custom ' + PIECES[it.piece].name.toLowerCase();
}
let bagOpener = null;
function openBag(focus, opener){
  bagOpener = opener || document.activeElement || bagBtn;
  bagPanel.hidden = false; bagBtn.setAttribute('aria-expanded', 'true'); $('#bagBtn2').setAttribute('aria-expanded', 'true');
  scrimEl.hidden = false; document.body.classList.add('bag-open');
  if (focus) bagPanel.focus();
}
function closeBag(focus){
  bagPanel.hidden = true; bagBtn.setAttribute('aria-expanded', 'false'); $('#bagBtn2').setAttribute('aria-expanded', 'false');
  scrimEl.hidden = true; document.body.classList.remove('bag-open');
  if (focus){
    const t = (bagOpener && document.body.contains(bagOpener) && bagOpener.getClientRects().length > 0) ? bagOpener : bagBtn;
    t.focus();
  }
}
function addToBag(){
  if (!count()){ say('Add at least one charm first.', true); return; }
  cart = loadCart();
  cart.push({type:'custom', piece:S.piece, chain:S.chain, charms:S.charms.slice(), names:S.charms.map(id => BY[id].name), price:price()});
  store.set('charmie-cart', cart);
  renderBag(); openBag(false);
  say('Custom ' + PIECES[S.piece].name.toLowerCase() + ' added to your bag. ' + plural(bagCount(cart), 'item') + ' in bag.');
}
[bagBtn, $('#bagBtn2')].forEach(btn => btn.addEventListener('click', () => { if (bagPanel.hidden){ openBag(true, btn); } else closeBag(true); }));
$('#bagClose').addEventListener('click', () => closeBag(true));
scrimEl.addEventListener('click', () => closeBag(true));
$('#bagList').addEventListener('click', e => {
  const qb = e.target.closest('[data-q]');
  if (qb){
    const d = +qb.dataset.q, r = stepQty(+qb.dataset.line, d);
    if (r.changed) store.set('charmie-cart', cart);
    renderBag();
    if (r.msg) say(r.msg);
    /* keep focus on the same stepper button after re-render */
    const f = r.at >= 0 ? $('#bagList [data-line="' + r.at + '"][data-q="' + d + '"]') : null;
    if (f) f.focus(); else bagPanel.focus();
    return;
  }
  const b = e.target.closest('[data-idx]'); if (!b) return;
  const idx = +b.dataset.idx;
  cart = loadCart();
  const gone = cart.splice(idx, 1)[0]; store.set('charmie-cart', cart); renderBag();
  say((gone ? itemTitle(gone) : 'Item') + ' removed. ' + plural(bagCount(cart), 'item') + ' in bag.');
  /* focus the next line's Remove (or the last one), else the panel */
  const fs = document.querySelectorAll('#bagList [data-idx]'), f = fs[Math.min(idx, fs.length - 1)];
  if (f) f.focus(); else bagPanel.focus();
});
window.addEventListener('storage', e => { if (e.key === 'charmie-cart'){ cart = loadCart(); renderBag(); } });
$('#addBag').addEventListener('click', addToBag);
$('#addBag2').addEventListener('click', addToBag);

/* ---------- toolbar ---------- */
function afterRestore(msg){
  sel = null; fresh = -1; persist(); renderAll();
  say(msg + ' ' + summary());
}
function undo(){
  if (!past.length){ say('Nothing to undo.'); return; }
  future.push(snap()); if (future.length > HIST) future.shift();
  S = past.pop(); afterRestore('Undone.');
}
function redo(){
  if (!future.length){ say('Nothing to redo.'); return; }
  past.push(snap()); if (past.length > HIST) past.shift();
  S = future.pop(); afterRestore('Redone.');
}
$('#undo').addEventListener('click', undo);
$('#redo').addEventListener('click', redo);
$('#shuffle').addEventListener('click', () => {
  if (count() < 2){ say('Add at least two charms to shuffle.', true); return; }
  commit(() => { for (let i = S.charms.length - 1; i > 0; i--){ const j = Math.floor(Math.random() * (i + 1)); const t = S.charms[i]; S.charms[i] = S.charms[j]; S.charms[j] = t; } });
  sel = null; renderAll(); say('Charms shuffled. ' + summary());
});
const clearBtn = $('#clear'), confirmEl = $('#confirm');
function cancelClear(focus){ confirmEl.hidden = true; clearBtn.hidden = false; if (focus) clearBtn.focus(); }
clearBtn.addEventListener('click', () => {
  if (!count()){ say('Nothing to clear.'); return; }
  clearBtn.hidden = true; confirmEl.hidden = false; $('#confirmYes').focus();
  say('Clear all charms? Choose Yes or No.');
});
$('#confirmNo').addEventListener('click', () => cancelClear(true));
$('#confirmYes').addEventListener('click', () => {
  commit(() => { S.charms = []; });
  sel = null; tabSlot = 0; cancelClear(true); renderAll(); say('All charms cleared. ' + summary());
});

function shareUrl(){
  return location.href.split('#')[0] + '#p=' + S.piece + '&c=' + S.chain + '&i=' + S.charms.join(',');
}
async function share(){
  const url = shareUrl();
  try{
    await navigator.clipboard.writeText(url);
    $('#sharePanel').hidden = true;
    say('Link copied to clipboard.', true);
  }catch(e){
    const inp = $('#shareInput'); inp.value = url; $('#sharePanel').hidden = false;
    inp.focus(); inp.select();
  }
}
$('#share').addEventListener('click', share);

const fetchCache = {};
function toDataURI(href){
  if (!fetchCache[href]){
    fetchCache[href] = fetch(href).then(r => { if (!r.ok) throw new Error('fetch failed'); return r.blob(); })
      .then(b => new Promise((res, rej) => { const fr = new FileReader(); fr.onload = () => res(fr.result); fr.onerror = () => rej(fr.error); fr.readAsDataURL(b); }))
      .catch(err => { delete fetchCache[href]; throw err; });
  }
  return fetchCache[href];
}
async function saveImage(){
  const btn = $('#save');
  btn.setAttribute('aria-disabled', 'true');
  say('Saving image…');
  try{
    const clone = stageSvg.cloneNode(true);
    clone.querySelectorAll('.ui').forEach(n => n.parentNode.removeChild(n));
    clone.removeAttribute('role'); clone.removeAttribute('aria-label');
    clone.setAttribute('xmlns', NS);
    clone.setAttribute('xmlns:xlink', 'http://www.w3.org/1999/xlink');
    clone.setAttribute('width', '1440'); clone.setAttribute('height', '840');
    const bg = PIECES[S.piece].bg;
    const defs = el('defs', {});
    const grad = el('radialGradient', {id:'bgg', cx:'50%', cy:'58%', r:'70%'});
    grad.appendChild(el('stop', {offset:'0', 'stop-color':bg[0]}));
    grad.appendChild(el('stop', {offset:'1', 'stop-color':bg[1]}));
    defs.appendChild(grad);
    clone.insertBefore(el('rect', {x:0, y:0, width:720, height:420, fill:'url(#bgg)'}), clone.firstChild);
    clone.insertBefore(defs, clone.firstChild);
    const imgs = Array.prototype.slice.call(clone.querySelectorAll('image'));
    await Promise.all(imgs.map(async im => {
      const data = await toDataURI(im.getAttribute('href'));
      im.setAttribute('href', data);
      im.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', data);
    }));
    const xml = new XMLSerializer().serializeToString(clone);
    const image = new Image();
    await new Promise((res, rej) => { image.onload = res; image.onerror = () => rej(new Error('render failed')); image.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(xml); });
    const canvas = document.createElement('canvas'); canvas.width = 1440; canvas.height = 840;
    canvas.getContext('2d').drawImage(image, 0, 0, 1440, 840);
    const blob = await new Promise((res, rej) => canvas.toBlob(b => b ? res(b) : rej(new Error('encode failed')), 'image/png'));
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a'); a.href = url; a.download = 'charmie-' + S.piece + '.png';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 2000);
    say('Image saved.', true);
  }catch(err){
    say('Sorry, we could not save the image here. Try a screenshot instead.', true);
  }finally{
    btn.setAttribute('aria-disabled', 'false');
  }
}
$('#save').addEventListener('click', () => { if ($('#save').getAttribute('aria-disabled') !== 'true') saveImage(); });

/* ---------- global keys ---------- */
document.addEventListener('keydown', e => {
  const t = e.target, typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
  const mod = e.ctrlKey || e.metaKey;
  if (mod && !e.altKey && (e.key === 'z' || e.key === 'Z')){
    if (typing) return;
    e.preventDefault(); if (e.shiftKey) redo(); else undo(); return;
  }
  if (mod && !e.altKey && (e.key === 'y' || e.key === 'Y')){
    if (typing) return;
    e.preventDefault(); redo(); return;
  }
  if ((e.key === '/' || e.code === 'Slash') && e.altKey && !mod){
    e.preventDefault(); setOpen(3, true); searchEl.focus(); return;
  }
  if (e.key === 'Escape'){
    if (!bagPanel.hidden) closeBag(true);
    else if (!confirmEl.hidden) cancelClear(true);
    else if (!$('#sharePanel').hidden){ $('#sharePanel').hidden = true; $('#share').focus(); }
    else if (sel !== null && !(t && t.id === 'q')){ sel = null; renderAll(); say('Slot deselected.'); }
    else if (mm.classList.contains('open')) closeMenu(true);
  }
});
window.addEventListener('hashchange', () => {
  const d = parseHash(); if (!d) return;
  commit(() => { S = d; });
  clearHash();
  sel = null; renderAll(); say('Design loaded from link. ' + summary());
});

/* ---------- menu ---------- */
const mb = $('#menuBtn'), mm = $('#mobileMenu');
function closeMenu(focus){ mm.classList.remove('open'); mb.setAttribute('aria-expanded', 'false'); if (focus) mb.focus(); }
window.matchMedia('(min-width:820px)').addEventListener('change', e => { if (e.matches) closeMenu(false); });
mb.addEventListener('click', () => { const o = mm.classList.toggle('open'); mb.setAttribute('aria-expanded', String(o)); });

/* ---------- pinned stage height (mobile sticky offsets) ---------- */
const pin = $('#pin');
function syncPin(){ document.documentElement.style.setProperty('--pinh', pin.offsetHeight + 'px'); }
if (window.ResizeObserver) new ResizeObserver(syncPin).observe(pin);
window.addEventListener('resize', syncPin);

/* ---------- compact pinned stage while browsing the charm grid (phones) ---------- */
let compact = false, compactRaf = 0;
function syncCompact(){
  compactRaf = 0;
  let on = false;
  if (phoneMQ.matches && openSteps.has(3) && getComputedStyle(pin).position === 'sticky'){
    const r = grid.getBoundingClientRect(), H = window.innerHeight;
    /* hysteresis: enter when the grid reaches 45% of the viewport, leave below 60% */
    on = r.bottom > 0 && r.top < H * (compact ? 0.6 : 0.45);
  }
  if (on !== compact){ compact = on; pin.classList.toggle('pin-compact', on); }
}
function queueCompact(){ if (!compactRaf) compactRaf = requestAnimationFrame(syncCompact); }
window.addEventListener('scroll', queueCompact, {passive:true});
window.addEventListener('resize', queueCompact);

/* ---------- init ---------- */
function renderAll(){
  renderStage(); renderSteps(); renderChosen(); renderRail(); updateTiles(); renderPrice(); renderTools();
}
document.querySelectorAll('[data-pr]').forEach(n => { const v = PRICING[n.dataset.pr]; if (typeof v === 'number') n.textContent = n.hasAttribute('data-inr') ? inr(v) : String(v); });
buildSteps();
renderGrid();
renderBag();
renderAll();
syncPin();
})();
</script>
<script src="checkout.js" defer></script>
</body>
</html>
